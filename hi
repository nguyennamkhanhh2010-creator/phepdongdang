<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mô hình phép đồng dạng</title><style>
body{font-family:Arial,sans-serif;background:#f4f6fb;color:#172033;margin:0;padding:18px}.wrap{max-width:1000px;margin:auto;background:white;padding:18px;border-radius:15px;box-shadow:0 4px 22px #17203318}h2{margin:0 0 8px}.sub{color:#526078;line-height:1.5}.stage{border:1px solid #dce3ee;border-radius:12px;background:#fcfdff;width:100%}svg{width:100%;height:auto;display:block}.controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:15px 0}.control{background:#f3f5fa;padding:12px;border-radius:9px}.control label{display:flex;justify-content:space-between;font-weight:bold;font-size:14px;margin-bottom:8px}.control input{width:100%}.legend{display:flex;gap:15px;flex-wrap:wrap;font-size:13px;color:#475569;margin:12px 0}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}.explain{background:#f3f5fa;padding:14px;border-radius:10px;line-height:1.65}.btn{margin-top:12px;background:#243b67;color:white;border:0;padding:10px 15px;border-radius:8px;font-weight:bold}.note{font-size:12px;color:#64748b}
</style></head><body><main class="wrap"><h2>Mô hình chứng minh hai tam giác đồng dạng</h2><p class="sub">Ta biến tam giác ABC thành tam giác A′B′C′ qua hai bước: phép vị tự tâm O, tỉ số k; sau đó là phép dời hình (quay và tịnh tiến). Kéo thanh trượt để thay đổi mô hình.</p>
<div class="stage"><svg id="svg" viewBox="0 0 800 500"><polygon id="base" fill="#3b82f6" fill-opacity=".13" stroke="#2563eb" stroke-width="3"/><polygon id="mid" fill="#f59e0b" fill-opacity=".13" stroke="#d97706" stroke-width="2.5" stroke-dasharray="8 5"/><polygon id="target" fill="#16a34a" fill-opacity=".13" stroke="#15803d" stroke-width="3"/><g id="guides"></g><g id="labels" font-size="16" font-weight="bold"></g><circle id="O" r="5" fill="#111827"/><text id="ot" font-size="14" font-weight="bold">O</text><g font-size="13" fill="#475569"><text x="20" y="25">ABC: ban đầu</text><text x="20" y="45">A₁B₁C₁: sau vị tự</text><text x="20" y="65">A′B′C′: sau dời hình</text></g></svg></div>
<div class="legend"><span><i class="dot" style="background:#2563eb"></i>ABC – ban đầu</span><span><i class="dot" style="background:#d97706"></i>A₁B₁C₁ – sau vị tự</span><span><i class="dot" style="background:#15803d"></i>A′B′C′ – sau dời hình</span></div>
<div class="controls"><div class="control"><label>Tỉ số vị tự k <output id="kv">1.50</output></label><input id="k" type="range" min="0.5" max="2.5" step="0.05" value="1.5"></div><div class="control"><label>Góc quay <output id="av">25°</output></label><input id="angle" type="range" min="-180" max="180" value="25"></div><div class="control"><label>Tịnh tiến ngang <output id="dxv">100</output></label><input id="dx" type="range" min="-180" max="180" step="5" value="100"></div><div class="control"><label>Tịnh tiến dọc <output id="dyv">-20</output></label><input id="dy" type="range" min="-120" max="120" step="5" value="-20"></div></div>
<div class="explain"><b>Chuỗi phép biến hình</b><br>1. Vị tự tâm O, tỉ số k: A → A₁, B → B₁, C → C₁. Các cạnh được nhân cùng hệ số k, các góc được bảo toàn.<br>2. Dời hình: quay A₁B₁C₁ một góc đã chọn rồi tịnh tiến. Phép dời hình bảo toàn độ dài và góc.<br><b>Kết luận:</b> tam giác A′B′C′ đồng dạng với ABC vì các cạnh tương ứng có cùng tỉ số k và các góc tương ứng bằng nhau.<div id="ratio"></div></div><button class="btn" id="reset">Đặt lại mô hình</button><p class="note">Đây là ví dụ minh họa do ta tự xây dựng vì đề không cho sẵn hai tam giác cụ thể.</p></main>
<script>
const base=[{x:120,y:350,n:'A'},{x:230,y:145,n:'B'},{x:365,y:350,n:'C'}],O={x:245,y:270},$=id=>document.getElementById(id),NS='http://www.w3.org/2000/svg';function point(p){return p.x+','+p.y}function transform(p,k,a,dx,dy){let x=O.x+k*(p.x-O.x),y=O.y+k*(p.y-O.y),r=a*Math.PI/180;return{x:O.x+(x-O.x)*Math.cos(r)-(y-O.y)*Math.sin(r)+dx,y:O.y+(x-O.x)*Math.sin(r)+(y-O.y)*Math.cos(r)+dy}}function update(){let k=+$('k').value,a=+$('angle').value,dx=+$('dx').value,dy=+$('dy').value,mid=base.map(p=>({x:O.x+k*(p.x-O.x),y:O.y+k*(p.y-O.y)})),end=base.map(p=>transform(p,k,a,dx,dy));[['base',base],['mid',mid],['target',end]].forEach(([id,ps])=>$(id).setAttribute('points',ps.map(point).join(' ')));$('kv').textContent=k.toFixed(2);$('av').textContent=a+'°';$('dxv').textContent=dx;$('dyv').textContent=dy;let g=$('guides');g.innerHTML='';base.forEach((p,i)=>{let l=document.createElementNS(NS,'line');[['x1',p.x],['y1',p.y],['x2',mid[i].x],['y2',mid[i].y]].forEach(([n,v])=>l.setAttribute(n,v));l.setAttribute('stroke','#9aa4b2');l.setAttribute('stroke-dasharray','4 5');g.appendChild(l)});let labels=$('labels');labels.innerHTML='';[...base.map((p,i)=>({...p,t:p.n})),...mid.map((p,i)=>({...p,t:['A₁','B₁','C₁'][i]})),...end.map((p,i)=>({...p,t:["A′","B′","C′"][i]}))].forEach(p=>{let t=document.createElementNS(NS,'text');t.setAttribute('x',p.x+7);t.setAttribute('y',p.y-8);t.textContent=p.t;labels.appendChild(t)});$('ratio').textContent='Tỉ số đồng dạng: A′B′/AB = B′C′/BC = C′A′/CA = k = '+k.toFixed(2)+'.'}$('O').setAttribute('cx',O.x);$('O').setAttribute('cy',O.y);$('ot').setAttribute('x',O.x+9);$('ot').setAttribute('y',O.y-8);['k','angle','dx','dy'].forEach(id=>$(id).addEventListener('input',update));$('reset').onclick=()=>{[['k',1.5],['angle',25],['dx',100],['dy',-20]].forEach(([id,v])=>$(id).value=v);update()};update();
</script></body></html>
